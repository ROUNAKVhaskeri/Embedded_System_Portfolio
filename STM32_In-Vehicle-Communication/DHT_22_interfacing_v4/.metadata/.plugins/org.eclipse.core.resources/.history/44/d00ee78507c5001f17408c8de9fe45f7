#define DHT22_GPIO_Port GPIOA
#define DHT22_PIN_NUMBER 1 // For direct register access
#define DHT22_PORT GPIOA

char message1[16]; // Not used, consider removing
char message2[16]; // Not used, consider removing
uint8_t TOUT = 0, checksum, i;
uint8_t T_Byte1, T_Byte2, RH_Byte1, RH_Byte2;

void delay_us(uint16_t us) {
    __HAL_TIM_SET_COUNTER(&htim1, 0);
    while (__HAL_TIM_GET_COUNTER(&htim1) < us);
}

void Start_Signal(void) {
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    // Configure PA1 as output (using HAL for initial setup)
    GPIO_InitStruct.Pin = DHT22_Pin;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(DHT22_GPIO_Port, &GPIO_InitStruct);

    HAL_GPIO_WritePin(DHT22_GPIO_Port, DHT22_Pin, GPIO_PIN_RESET);
    HAL_Delay(18);
    HAL_GPIO_WritePin(DHT22_GPIO_Port, DHT22_Pin, GPIO_PIN_SET);
    delay_us(30);

    // Configure PA1 as input (using HAL)
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    HAL_GPIO_Init(DHT22_GPIO_Port, &GPIO_InitStruct);
    delay_us(5); // Important delay after mode change
}

uint8_t check_response(void) {
    __HAL_TIM_SET_COUNTER(&htim1, 0);
    while (!(DHT22_PORT->IDR & (1 << DHT22_PIN_NUMBER)) && __HAL_TIM_GET_COUNTER(&htim1) < 100);
    if (__HAL_TIM_GET_COUNTER(&htim1) >= 100) return 0;

    __HAL_TIM_SET_COUNTER(&htim1, 0);
    while ((DHT22_PORT->IDR & (1 << DHT22_PIN_NUMBER)) && __HAL_TIM_GET_COUNTER(&htim1) < 100);
    if (__HAL_TIM_GET_COUNTER(&htim1) >= 100) return 0;

    return 1;
}

uint8_t read_byte(void) {
    uint8_t num = 0;
    for (int i = 0; i < 8; i++) {
        while (!(DHT22_PORT->IDR & (1 << DHT22_PIN_NUMBER))); // Wait for HIGH
        __HAL_TIM_SET_COUNTER(&htim1, 0);
        while ((DHT22_PORT->IDR & (1 << DHT22_PIN_NUMBER)) && __HAL_TIM_GET_COUNTER(&htim1) < 100);
        if (__HAL_TIM_GET_COUNTER(&htim1) > 40) {
            num |= (1 << (7 - i));
        }
        delay_us(5);
    }
    return num;
}

void send_uart(char *str) {
    HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), HAL_MAX_DELAY);
}

int main(void) {
    char msg[50];
    uint16_t rh, temp;
    int8_t sign;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_TIM1_Init();
    MX_USART1_UART_Init();
    MX_USART2_UART_Init();

    HAL_TIM_Base_Start(&htim1);
    send_uart("Initialization Completed!\r\n");

    while (1) {
        HAL_Delay(2000); // Read every 2 seconds

        Start_Signal();
        if (!check_response()) {
            send_uart("No Response from the Sensor!\r\n");
            continue;
        }

        RH_Byte1 = read_byte();
        RH_Byte2 = read_byte();
        T_Byte1 = read_byte();
        T_Byte2 = read_byte();
        checksum = read_byte();

        if (checksum != (RH_Byte1 + RH_Byte2 + T_Byte1 + T_Byte2) & 0xFF) {
            send_uart("Checksum Error!\r\n");
            continue;
        }

        rh = (RH_Byte1 << 8) | RH_Byte2;
        temp = (T_Byte1 << 8) | T_Byte2;
        sign = (temp & 0x8000) ? -1 : 1;
        if (sign == -1) temp &= 0x7FFF;

        sprintf(msg, "RH: %u.%u%%, Temp: %d.%uC\r\n", rh / 10, rh % 10, sign * (temp / 10), temp % 10);
        send_uart(msg);
    }
}
